{
  "name": "soccer-star",
  "version": "0.3.1",
  "description": "축구선수 키우기 — 고교부터 발롱도르까지, 같은 세계의 플레이어들과 경쟁하는 방치형 커리어 게임",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "app": "electron .",
    "app:local": "SOCCER_WEB=http://localhost:3140 electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.joo.soccerstar",
    "productName": "SoccerStar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "index.html",
      "style.css",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "identity": "-",
      "artifactName": "SoccerStar-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "축구선수 키우기",
        "LSUIElement": true
      },
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "SoccerStar"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "SoccerStar-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "축구선수 키우기"
    }
  }
}
